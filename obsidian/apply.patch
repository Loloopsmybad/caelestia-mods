+def _obsidian_css_block(mode: str, colours: dict[str, str]) -> str:
+    def c(*keys: str, fallback: str = "000000") -> str:
+        for key in keys:
+            value = colours.get(key)
+            if value and len(value) == 6:
+                return value
+        return fallback
+
+    def rgb(hex_colour: str) -> str:
+        return ", ".join(str(int(hex_colour[i : i + 2], 16)) for i in (0, 2, 4))
+
+    h, s, l = _hex_to_hsl(c("primary", fallback="7aa2f7" if mode == "dark" else "1e66f5"))
+    surface = c("surface", "background")
+    surface_low = c("surfaceContainerLow", "surfaceContainer", "surface")
+    surface_high = c("surfaceContainerHigh", "surfaceContainer", "surface")
