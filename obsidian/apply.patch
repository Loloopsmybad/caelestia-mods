+@log_exception
+def apply_obsidian(colours: dict[str, str], mode: str) -> None:
+    scheme = get_scheme()
+    other_mode = "light" if mode == "dark" else "dark"
+
+    other: dict[str, str] | None = None
+    if scheme.name != "dynamic":
+        path = (scheme_data_dir / scheme.name / scheme.flavour / other_mode).with_suffix(".txt")
+        if path.is_file():
+            try:
+                other = read_colours_from_file(path)
+            except OSError:
+                other = None
+
+    if other is None:
+        from caelestia.utils.material.generator import gen_scheme, hex_to_hct
+
+        class _Mode:
+            pass
+
+        other_scheme = _Mode()
+        other_scheme.mode = other_mode
+        other_scheme.variant = scheme.variant
+        other_scheme.flavour = scheme.flavour
+        try:
+            other = gen_scheme(other_scheme, hex_to_hct(colours["primary"]))
+        except KeyError:
+            other = colours
+
+    dark = colours if mode == "dark" else other
+    light = colours if mode == "light" else other
+    css = "/* Generated by caelestia. Do not edit manually. */\n" + "\n".join(
+        (_obsidian_css_block("dark", dark), _obsidian_css_block("light", light))
+    )
+
+    obsidian_config = Path("~/.config/obsidian/obsidian.json").expanduser()
+    try:
+        vaults = json.loads(obsidian_config.read_text()).get("vaults", {})
+    except (OSError, json.JSONDecodeError):
+        vaults = {}
+
+    for meta in vaults.values():
+        vault = Path(meta["path"]) / ".obsidian"
+        theme_dir = vault / "themes" / "Caelestia"
+        theme_dir.mkdir(parents=True, exist_ok=True)
+        atomic_write(
+            theme_dir / "manifest.json",
+            json.dumps(
+                {
+                    "name": "Caelestia",
+                    "version": "1.0.0",
+                    "minAppVersion": "1.0.0",
+                    "author": "Caelestia",
+                    "authorUrl": "https://github.com/caelestia-dots/cli",
+                }
+            ),
+        )
+        atomic_write(theme_dir / "theme.css", css)
+
+        appearance_path = vault / "appearance.json"
+        try:
+            appearance = json.loads(appearance_path.read_text())
+        except (OSError, json.JSONDecodeError):
+            appearance = {}
+        appearance["cssTheme"] = "Caelestia"
+        appearance["theme"] = "obsidian" if mode == "dark" else "moonstone"
+        appearance["accentColor"] = f"#{colours['primary']}"
+        atomic_write(appearance_path, json.dumps(appearance))
+
